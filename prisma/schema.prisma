generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Guild {
  id                        String    @id @default(uuid())
  discordGuildId            String    @unique
  studyRoomTriggerChannelId String?
  studyRoomCategoryId       String?
  adminLogChannelId         String?
  maxStudyRoomsPerGuild     Int       @default(10)
  createdAt                 DateTime  @default(now())

  quizSessions     QuizSession[]
  studyRooms       StudyRoom[]
  pomodoroSessions PomodoroSession[]
  flashcardDecks   FlashcardDeck[]

  @@index([discordGuildId])
}

model User {
  id             String    @id @default(uuid())
  discordUserId  String    @unique
  username       String
  streakCount          Int       @default(0)
  lastActiveDate       DateTime?
  dailyReminderEnabled Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  quizSessions     QuizSession[]
  studyRooms       StudyRoom[]
  pomodoroSessions PomodoroSession[]
  flashcardDecks   FlashcardDeck[]
  aiUsageLogs      AiUsageLog[]

  @@index([discordUserId])
}

model QuizSession {
  id              String    @id @default(uuid())
  userId          String
  guildId         String?
  topic           String    @db.VarChar(200)
  totalQuestions  Int       @default(0)
  correctAnswers  Int       @default(0)
  createdAt       DateTime  @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild     Guild?        @relation(fields: [guildId], references: [id], onDelete: SetNull)
  questions QuizQuestion[]

  @@index([userId])
  @@index([guildId])
}

model QuizQuestion {
  id             String   @id @default(uuid())
  quizSessionId  String
  question       String
  options        Json
  correctOption  String
  userAnswer     String?
  isCorrect      Boolean?
  explanation    String
  answeredAt     DateTime?

  quizSession QuizSession @relation(fields: [quizSessionId], references: [id], onDelete: Cascade)

  @@index([quizSessionId])
}

model FlashcardDeck {
  id          String      @id @default(uuid())
  userId      String
  guildId     String?
  name        String      @db.VarChar(100)
  description String?
  createdAt   DateTime    @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild Guild?      @relation(fields: [guildId], references: [id], onDelete: SetNull)
  cards Flashcard[]

  @@unique([userId, name])
  @@index([userId])
}

model Flashcard {
  id           String        @id @default(uuid())
  deckId       String
  front        String        @db.VarChar(1000)
  back         String        @db.VarChar(1000)
  repetition   Int           @default(0)
  interval     Int           @default(1)
  easeFactor   Float         @default(2.5)
  nextReviewAt DateTime      @default(now())
  createdAt    DateTime      @default(now())

  deck FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@index([deckId, nextReviewAt])
}

model AiUsageLog {
  id          String   @id @default(uuid())
  userId      String
  actionType  String   // "AI_QUESTION" | "AI_SUMMARIZE" | "AI_QUIZ" | "AI_FLASHCARD"
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, actionType, createdAt])
}

model StudyRoom {
  id         String   @id @default(uuid())
  guildId    String
  channelId  String   @unique
  ownerId    String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  owner User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([guildId, isActive])
}

model PomodoroSession {
  id           String    @id @default(uuid())
  userId       String
  guildId      String
  channelId    String
  workMinutes  Int       @default(25)
  breakMinutes Int       @default(5)
  status       String    @default("WORK")
  startedAt    DateTime  @default(now())
  endsAt       DateTime
  stoppedAt    DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([channelId])
}
