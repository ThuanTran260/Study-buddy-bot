{
  "name": "bot-discord",
  "version": "1.0.0",
  "description": "Study Buddy Discord Bot",
  "packageManager": "pnpm@11.23.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "deploy:commands": "ts-node src/deploy-commands.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [
    "discord-bot",
    "ai",
    "study-buddy"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@prisma/client": "5.22.0",
    "@types/ioredis-mock": "^8.2.8",
    "discord.js": "^14.18.0",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "ioredis-mock": "^8.13.1",
    "node-cron": "^4.6.0",
    "openai": "^4.86.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.9",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0",
    "jest-util": "^30.4.1",
    "prettier": "^3.9.6",
    "prisma": "5.22.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.68.0"
  }
}
